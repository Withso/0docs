# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# ─── Dependencies ──────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ─── Build output ──────────────────────────────────────────────────
dist/
build/
out/
out-tsc/
tmp/
*.tsbuildinfo
.expo/
.expo-shared/
.next/
.nuxt/
.svelte-kit/
.turbo/
.vite/

# ─── Environment & secrets ─────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
!.env.example
*.pem
*.key

# ─── Logs ──────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
testem.log
logs/

# ─── Coverage & test output ────────────────────────────────────────
/coverage
/.nyc_output
/typings

# ─── IDE / editor ──────────────────────────────────────────────────
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# ─── OS files ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ─── Replit-specific (don't push to GitHub) ────────────────────────
.replit
.replitignore
replit.md
replit.nix
.upm/
.breakpoints
.agents/
.cache/
.config/
.local/
**/.replit-artifact/

# ─── Workspace dev artifacts (not part of the OSS source) ──────────
attached_assets/
screenshots/
artifact.toml

# ─── Misc ──────────────────────────────────────────────────────────
/.sass-cache
/connect.lock
/libpeerconnection.log
