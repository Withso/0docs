# 0docs — environment configuration
# Copy this file to `.env` and edit. `install.sh` does this for you and
# generates a fresh SESSION_SECRET on first run.

# ────────────────────────────────────────────────────────────────────────
# Database
# ────────────────────────────────────────────────────────────────────────
# Standard Postgres connection string. The default below points at the
# docker-compose Postgres service. On Railway, the Postgres plugin
# populates this for you. Bringing your own Postgres? Replace it with
# your own connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zerodocs

# ────────────────────────────────────────────────────────────────────────
# Sessions / cookies
# ────────────────────────────────────────────────────────────────────────
# Random 64+ char string. install.sh generates one for you on first run.
SESSION_SECRET=replace-me-with-a-long-random-string

# ────────────────────────────────────────────────────────────────────────
# Admin bootstrap
# ────────────────────────────────────────────────────────────────────────
# If both ADMIN_EMAIL and ADMIN_PASSWORD are set, install.sh creates this
# user as admin on first run. Re-runs leave the existing password alone
# and just re-assert is_admin=true. If only ADMIN_EMAIL is set, the first
# user that signs up via the web UI with that email is marked admin. If
# neither is set, the very first account created via the web UI becomes
# admin.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-at-least-8-chars

# Set to "true" to disable public signup once your team has accounts.
# Login + password reset still work, and the very first user can still
# sign up (so a fresh install can complete its bootstrap).
DISABLE_SIGNUP=false

# ────────────────────────────────────────────────────────────────────────
# Servers / ports
# ────────────────────────────────────────────────────────────────────────
# Port the API server listens on. On Railway this is provided as $PORT.
PORT=8081
# Port the Vite dev server listens on (only used in `pnpm run dev`).
WEB_PORT=5173
# Set to "production" for production deploys.
NODE_ENV=development

# Comma-separated list of CORS origins to allow in production. Add your
# public origin here if the API and web app live on different hosts.
# CORS_ALLOWLIST=https://docs.example.com

# ────────────────────────────────────────────────────────────────────────
# Optional integrations
# ────────────────────────────────────────────────────────────────────────
# OpenAI API key powers the "Ask docs" AI feature. The product still
# works without it — the AI button surfaces a friendly "not configured"
# error.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional SMTP for password-reset emails. When unset, reset links are
# printed to the server console so first-run flows still work.
# Format: smtp://user:pass@host:port  or  smtps://user:pass@host:465
# SMTP_URL=
# SMTP_FROM=noreply@example.com

# ────────────────────────────────────────────────────────────────────────
# Optional S3-compatible storage (Phase 2 — image uploads)
# ────────────────────────────────────────────────────────────────────────
# When set, image uploads are stored in S3/R2/MinIO instead of the local
# filesystem (which is ephemeral on Railway). Leave unset to use the
# local-disk default.
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=
