# 0docs — environment configuration
# Copy this file to `.env` and edit. `install.sh` does this for you and
# generates a fresh SESSION_SECRET on first run.
#
# This file documents BOTH operating modes:
#   AUTH_MODE=replit    → original Replit OIDC flow (the hosted demo)
#   AUTH_MODE=selfhost  → email + password, runnable anywhere

# ────────────────────────────────────────────────────────────────────────
# Auth mode
# ────────────────────────────────────────────────────────────────────────
# Default = replit (so the Replit-hosted demo keeps working unchanged).
# Self-hosters should set this to `selfhost`.
AUTH_MODE=selfhost

# Self-host only: bootstrap admin user. If both ADMIN_EMAIL and
# ADMIN_PASSWORD are set, install.sh creates this user as admin on first
# run (and re-runs leave the existing password alone, just re-asserting
# is_admin=true). If only ADMIN_EMAIL is set, the first user that signs
# up via the web UI with that email is marked admin. If neither is set,
# the very first account created via the web UI becomes admin.
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-at-least-8-chars

# Self-host only: set to "true" to disable public signup once your team
# has created their accounts. Login + password reset still work.
SELFHOST_DISABLE_SIGNUP=false

# Replit-mode only — leave blank in selfhost mode.
# REPL_ID=
# ISSUER_URL=https://replit.com/oidc

# ────────────────────────────────────────────────────────────────────────
# Database
# ────────────────────────────────────────────────────────────────────────
# Standard Postgres URL. The default below points at the docker-compose
# Postgres service. If you're bringing your own Postgres, replace it with
# your own connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zerodocs

# Optional: set to a separate database used by both dev and a deployment
# of the same instance. Takes precedence over DATABASE_URL when set.
# SHARED_DATABASE_URL=

# ────────────────────────────────────────────────────────────────────────
# Sessions / cookies
# ────────────────────────────────────────────────────────────────────────
# Random 64+ char string. install.sh generates one for you on first run.
SESSION_SECRET=replace-me-with-a-long-random-string

# ────────────────────────────────────────────────────────────────────────
# Servers / ports
# ────────────────────────────────────────────────────────────────────────
# API server port (Express).
API_PORT=8081
# Web app port (Vite).
WEB_PORT=8080
# Set to "production" for production deploys.
NODE_ENV=development

# Comma-separated list of additional CORS origins to allow in production
# (in addition to *.replit.dev/.replit.app and localhost).
# CORS_ALLOWLIST=https://docs.example.com

# ────────────────────────────────────────────────────────────────────────
# Optional integrations
# ────────────────────────────────────────────────────────────────────────
# OpenAI API key powers the "Ask docs" AI feature. The product still works
# without it — the AI button surfaces a friendly "not configured" error.
# OPENAI_API_KEY=

# Optional SMTP for password-reset emails. When unset, reset links are
# printed to the server console so first-run flows still work.
# Format: smtp://user:pass@host:port  or  smtps://user:pass@host:465
# SMTP_URL=
# SMTP_FROM=noreply@example.com
