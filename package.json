{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "preinstall": "rm -f package-lock.json yarn.lock",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "install:local": "bash ./install.sh",
    "dev": "pnpm -r --parallel --filter @workspace/api-server --filter @workspace/zdocs run dev",
    "db:migrate": "pnpm --filter @workspace/db run push"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
